[Unit]
Description=Bling Empire dashboard (signals + runway)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Project-Bling-Empire/v2
ExecStart=/root/Project-Bling-Empire/env/bin/uvicorn dashboard.app:app --host 127.0.0.1 --port 3400
Restart=always
RestartSec=5
MemoryMax=1G

[Install]
WantedBy=multi-user.target
